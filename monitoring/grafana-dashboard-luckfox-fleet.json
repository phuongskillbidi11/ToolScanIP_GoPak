      "type": "stat",
      "title": "Node status",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "efzaru4stjbwgc"
      },
      "repeat": "fleet",
      "repeatDirection": "h",
      "maxPerRow": 10,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "efzaru4stjbwgc"
          },
          "expr": "sum(count_over_time({job=\"node-oee\", node_ip=\"${fleet:raw}\"}[3m])) or vector(0)",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${fleet}",
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SILENT",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Log lines received from this node in the last 3 minutes. SILENT = nothing received (node down, collector cannot reach it, or its log is not growing).",
