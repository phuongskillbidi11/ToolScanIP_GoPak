    {
      "type": "timeseries",
      "title": "RAM free (MB)",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "efzaru4stjbwgc"
      },
      "interval": "1m",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "efzaru4stjbwgc"
          },
          "expr": "last_over_time({job=\"node-oee\", node_ip=~`${node:regex}`} |= \"RAM: total\" | regexp `free (?P<v>[0-9]+) MB` | unwrap v | __error__=\"\" [$__interval]) by (node_ip)",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{node_ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": 180000,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "suffix: MB",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              }
            ]
